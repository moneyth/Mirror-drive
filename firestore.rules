rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validator for UserProgress entity
    function isValidUserProgress(data) {
      return data.userId is string
        && data.userId == request.auth.uid
        && data.unlockedLevels is list
        && data.levelBestTimes is map
        && data.settings is map
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProgress(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProgress(incoming());
    }
  }
}
